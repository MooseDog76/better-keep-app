{
  "manifest_version": 3,
  "name": "Better Keep",
  "version": "1.2.0",
  "description": "Right-click to save a page, a link, selected text or an image to a Better Keep notebook.",
  "permissions": [
    "contextMenus",
    "storage",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "https://puhvhtioltyfiwrvmdjd.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Better Keep"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "key": "",
  "externally_connectable": {
    "matches": [
      "https://moosedog76.github.io/better-keep-app/*"
    ]
  }
}
